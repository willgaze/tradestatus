# Postgres. Its OWN database — do not point this at another product's.
DATABASE_URL="postgresql://user:password@host/mytradestatus?sslmode=require"

# Signs the operator session cookie. Any long random string.
JWT_SECRET="change-me-to-something-long-and-random"

# The password for the operator console at /dashboard.
OPERATOR_PASSWORD="change-me"

# Whose name and number the customer sees on their tracking page.
NEXT_PUBLIC_TRADE_NAME="Rosebourne Plumbing"
NEXT_PUBLIC_TRADE_PHONE="01264 502027"
NEXT_PUBLIC_TRADE_PHONE_TEL="01264502027"

# Time zone every date on the customer's page is formatted in.
NEXT_PUBLIC_TRADE_TIMEZONE="Europe/London"

# Push notifications ("they have set off" on the lock screen). Generate a pair
# with:  npx web-push generate-vapid-keys
# Without both of these the notify row simply does not appear — nothing breaks.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# ServiceM8 (optional). The key from ServiceM8 → Settings → API Keys, and a long
# random secret that becomes part of the webhook URL. scripts/connect-servicem8.sh
# sets both in Vercel.
SM8_API_KEY=""
SM8_WEBHOOK_TOKEN=""

# Apple Wallet signing. All six come from `bash scripts/apple-wallet.sh`
# (see docs/apple-wallet.md). PEMs may be the text or base64 of it.
PASSKIT_CERT_PEM=""
PASSKIT_KEY_PEM=""
PASSKIT_KEY_PASSWORD=""
PASSKIT_WWDR_PEM=""
PASSKIT_PASS_TYPE_ID=""
PASSKIT_TEAM_ID=""
